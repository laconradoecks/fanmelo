# systemd unit for the FANMELO waitlist API.
# Install: cp /var/www/fanmelo/repo/deploy/waitlist/fanmelo-waitlist.service /etc/systemd/system/
#          systemctl daemon-reload && systemctl enable --now fanmelo-waitlist
[Unit]
Description=FANMELO waitlist API
After=network.target

[Service]
ExecStart=/usr/bin/python3 -I /var/www/fanmelo/repo/deploy/waitlist/app.py
Environment=WAITLIST_DB=/var/lib/fanmelo/waitlist.db
Environment=WAITLIST_PORT=8788
# Add the temporary sslip.io address here too while testing before the domain is live, e.g.
# Environment=ADMIN_ORIGINS=https://fanmelo.com,https://www.fanmelo.com,http://fanmelo.138.197.117.174.sslip.io
Environment=ADMIN_ORIGINS=https://fanmelo.com,https://www.fanmelo.com
# Runs as a throwaway unprivileged user; the database lives in /var/lib/fanmelo.
DynamicUser=yes
StateDirectory=fanmelo
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
